<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      An external display whose screen is caught mid-dim: the lit half and the dark half
      meet on an elliptical terminator, so the screen reads as a moon phase. That is the
      app in one mark - a monitor, at night, being dimmed rather than brightened.
      All geometry stays inside a radius-33 circle around (54,54) so no adaptive mask clips it.
    -->

    <!-- Stand, drawn first so the panel overlaps its neck. -->
    <path
        android:fillColor="#93A6C6"
        android:pathData="M50,60h8l1.5,11h-11z" />
    <path
        android:fillColor="#AFC0DC"
        android:pathData="M42,71h24a2,2 0 0 1 0,4h-24a2,2 0 0 1 0,-4z" />

    <!-- Bezel. -->
    <path android:pathData="M35,34h38a5,5 0 0 1 5,5v20a5,5 0 0 1 -5,5h-38a5,5 0 0 1 -5,-5v-20a5,5 0 0 1 5,-5z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30" android:startY="34"
                android:endX="78" android:endY="64"
                android:startColor="#F4F7FF"
                android:endColor="#9FB3D4" />
        </aapt:attr>
    </path>

    <!-- Screen, fully dimmed. -->
    <path
        android:fillColor="#0A1226"
        android:pathData="M36.5,38h35a2.5,2.5 0 0 1 2.5,2.5v17a2.5,2.5 0 0 1 -2.5,2.5h-35a2.5,2.5 0 0 1 -2.5,-2.5v-17a2.5,2.5 0 0 1 2.5,-2.5z" />

    <!-- The part still lit. The 12x11 arc is the terminator. -->
    <path android:pathData="M36.5,38h15.5a7,11 0 0 1 0,22h-15.5a2.5,2.5 0 0 1 -2.5,-2.5v-17a2.5,2.5 0 0 1 2.5,-2.5z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34" android:startY="38"
                android:endX="60" android:endY="60"
                android:startColor="#FFF7E2"
                android:endColor="#C9DDFF" />
        </aapt:attr>
    </path>
</vector>
